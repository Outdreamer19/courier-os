# =============================================================================
# CourierOS — production / client-UAT environment template
# =============================================================================
# Copy this to .env on the server (Forge writes it for you via the site's
# "Environment" editor) and fill in every value marked CHANGE_ME.
#
# NEVER commit the real .env. This file is a template only.
# =============================================================================

APP_NAME="CourierOS"
APP_ENV=production
APP_KEY=CHANGE_ME                       # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://courieros.co

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Multi-tenancy
# -----------------------------------------------------------------------------
# Tenants live at {subdomain}.{central_domain}. Today Shipping resolves from
# the `today` subdomain -> https://today.courieros.co
# Requires a wildcard DNS record (*.courieros.co) and a wildcard TLS cert.
COURIEROS_CENTRAL_DOMAIN=courieros.co
COURIEROS_DEFAULT_CURRENCY=USD
COURIEROS_DEFAULT_RATE_PER_LB=500

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=courieros
DB_USERNAME=forge
DB_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Session / cache / queue
# -----------------------------------------------------------------------------
# SESSION_DOMAIN is deliberately left null. A null value scopes the session
# cookie to the exact host, which keeps each tenant subdomain's session
# isolated. Setting it to ".courieros.co" would share one session across every
# tenant — do not do that.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail (Resend)
# -----------------------------------------------------------------------------
# The sending domain must be verified in Resend (SPF + DKIM DNS records) or
# registration / email-verification / invoice mail will silently fail — which
# blocks the whole customer signup flow, since /dashboard is behind `verified`.
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@courieros.co"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# InvoiceFeed
# -----------------------------------------------------------------------------
INVOICEFEED_API_URL=https://invoicefeed.com/api/v1
INVOICEFEED_API_TOKEN=CHANGE_ME
INVOICEFEED_ENABLED=true
INVOICEFEED_WEBHOOK_SECRET=CHANGE_ME

# -----------------------------------------------------------------------------
# Stripe / Cashier (platform subscription billing)
# -----------------------------------------------------------------------------
# For client UAT, keep Stripe in TEST mode. The Today Shipping tenant is
# seeded with status=active, and EnsureTenantSubscribed treats an active
# tenant as entitled — so the portal works without a live subscription.
STRIPE_KEY=CHANGE_ME
STRIPE_SECRET=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
STRIPE_PRICE_MONTHLY=CHANGE_ME
STRIPE_PRICE_SETUP=CHANGE_ME
CASHIER_CURRENCY=usd

# What the marketing page advertises and what the platform dashboard uses to
# compute MRR/ARR. These are display/reporting values — they must match the
# amounts on the Stripe prices above, or your revenue reporting will lie.
COURIEROS_PRICE_MONTHLY=79
COURIEROS_PRICE_SETUP=349

# -----------------------------------------------------------------------------
# Frontend build
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
